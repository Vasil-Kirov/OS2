module main;

_ :: #import sys;

DisplayCmd :: enum: u8 {
	NOP,
	DrawColor,   // x: u16, y: u16, w: u16, h: u16, color: u32
	DrawTex,     // x: u16, y: u16, w: u16, h: u16, pixel_buf: []u32
	SwapBuffers, // x: u16, y: u16, w: u16, h: u16
};

swap_buffers :: fn(display: i32) {
	buf: [9]u8;
	buf[0] = DisplayCmd.SwapBuffers;
	*cast(*u16, &buf[1]) = 0;
	*cast(*u16, &buf[3]) = 0;
	*cast(*u16, &buf[5]) = 1600;
	*cast(*u16, &buf[7]) = 900;
	syscall(.write, display, buf[:]);
}

draw_rect :: fn(display: i32, x: u16, y: u16, w: u16, h: u16, color: u32) {
	buf: [13]u8;
	buf[0] = DisplayCmd.DrawColor;
	*cast(*u16, &buf[1]) = x;
	*cast(*u16, &buf[3]) = y;
	*cast(*u16, &buf[5]) = w;
	*cast(*u16, &buf[7]) = h;
	*cast(*u32, &buf[9]) = color;
	syscall(.write, display, buf[:]);
}

_start :: fn() #foreign #link="_start" {
	tty := syscall(.open, "/dev/tty0", 0);
	if tty < 0 {
		for {}
	}
	print_num(tty, "Child spawned: ", syscall(.getpid));

	display := syscall(.open, "/dev/display", 0);
	if display < 0 {
		syscall(.write, tty, "Failed to open display!\n");
		for {};
	}
	syscall(.write, tty, "Opened display!\n");

	draw_rect(display, 16, 16, 64, 64, 0x0000FEFF);
	swap_buffers(display);
	for {
		syscall(.write, tty, "PROCESS 2!\n");
	}

	syscall(.close, display);
	syscall(.close, tty);
}



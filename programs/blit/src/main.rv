module main;

SyscallN :: enum: u32 {
	read,   // (fd, buf, size)
	write,  // (fd, buf, size)
	open,   // (name, name_len, flags)
	close,  // (fd)
}

DisplayCmd :: enum: u8 {
	NOP,
	DrawColor,   // x: u16, y: u16, w: u16, h: u16, color: u32
	DrawTex,     // x: u16, y: u16, w: u16, h: u16, pixel_buf: []u32
	SwapBuffers, // x: u16, y: u16, w: u16, h: u16
};

syscall_ :: fn(eax: u32, ebx: u32, ecx: u32, edx: u32, esi: u32, edi: u32) -> i32 #foreign #link="syscall" #cc="cdecl";

ru32arg :: fn(arg: Arg) -> u32 {
	return *cast(*u32, arg.val);
}

syscall :: fn(call: SyscallN, args: ...) -> i32 {
	eax: u32 = cast(u32, call);
	ebx: u32 = 0;
	ecx: u32 = 0;
	edx: u32 = 0;
	esi: u32 = 0;
	edi: u32 = 0;
	regs := []*u32{&ebx, &ecx, &edx, &esi, &edi};
	for reg in regs { *reg = 0; }

	at_reg := 0;
	for arg in args {
		if at_reg == len(regs)
			return -22;

		if arg.t == string {
			s := *cast(*string, arg.val);
			*regs[at_reg++] = s.data as u32;
			if at_reg == len(regs)
				return -22;
			*regs[at_reg++] = s.count as u32;
		} else if arg.t == []u8 {
			s := *cast(*[]u8, arg.val);
			*regs[at_reg++] = s.data as u32;
			if at_reg == len(regs)
				return -22;
			*regs[at_reg++] = s.count as u32;
		} else {
			*regs[at_reg++] = ru32arg(arg);
		}
	}
	return syscall_(eax, ebx, ecx, edx, esi, edi);
}

swap_buffers :: fn(display: i32) {
	buf: [9]u8;
	buf[0] = DisplayCmd.SwapBuffers;
	*cast(*u16, &buf[1]) = 0;
	*cast(*u16, &buf[3]) = 0;
	*cast(*u16, &buf[5]) = 1600;
	*cast(*u16, &buf[7]) = 900;
	syscall(.write, display, buf[:]);
}

draw_rect :: fn(display: i32, x: u16, y: u16, w: u16, h: u16, color: u32) {
	buf: [13]u8;
	buf[0] = DisplayCmd.DrawColor;
	*cast(*u16, &buf[1]) = x;
	*cast(*u16, &buf[3]) = y;
	*cast(*u16, &buf[5]) = w;
	*cast(*u16, &buf[7]) = h;
	*cast(*u32, &buf[9]) = color;
	syscall(.write, display, buf[:]);
}

_start :: fn() #foreign #link="_start" {
	tty := syscall(.open, "/dev/tty0", 0);
	if tty < 0 {
		for {}
	}
	syscall(.write, tty, "TTY init!\n");

	display := syscall(.open, "/dev/display", 0);
	if display < 0 {
		syscall(.write, tty, "Failed to open display!\n");
		for {};
	}
	syscall(.write, tty, "Opened display!\n");

	draw_rect(display, 16, 16, 64, 64, 0x0000FEFF);
	swap_buffers(display);
	for {
	}

	syscall(.close, display);
	syscall(.close, tty);
}



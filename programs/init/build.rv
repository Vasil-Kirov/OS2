module build;

_ :: #import compile;
_ :: #import misc;
_ :: #import io;
#import mem;
#import str;

system :: fn(cmd: *u8) -> i32 #foreign;

compile :: fn() -> CompileInfo {
	return .{
		files = .{"main.rv", "sys.rv"},
		source_dirs = []string {"src", ".." },
        opt = 0,
		output = "init",
        flags = .DebugInfo | .CrossVOS | .DisableBoundsCheck,
	};
}


after_link :: fn(objs: []string) {
	system(c"move bin\\init ..\\..\\mnt\\init");
}


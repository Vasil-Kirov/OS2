module main;

_ :: #import sys;




_start :: fn() #foreign #link="_start" {
	tty := open("/dev/tty0", 0);
	if tty < 0 {
		for {}
	}
	writes(tty, "Opening root...\n");
	root := open("/", 0);
	if root < 0 {
		writes(tty, "Failed to open root!\n");
		for {}
	}
	writes(tty, "Initial process started!\n");

	buf: [1024]string;
	read := readdir(root, buf[:]);
	if read < 0 {
		//syscall(.write, tty, "Failed to read root!\n");
		print_num(tty, "Failed to read root!", read);
		for {}
	}
	writes(tty, "Printing dirs...\n");
	dirs := buf[:read];
	for dir in dirs {
		writes(tty, "\t");
		writes(tty, dir);
		writes(tty, "\n");
	}

	writes(tty, "Printed!");
	for {
	}
}


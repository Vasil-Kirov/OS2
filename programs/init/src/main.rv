module main;

_ :: #import misc;
#import os;
_ :: #import vos;

main :: fn() {
	println("Opening root...");
	root := open("/", .ReadOnly);
	if root < 0 {
		println("Failed to open root: %", root);
		for {}
	}
	println("Proc started: %...", root);

	p, ok := os.alloc(size_of(string) * 1024, .Reserve | .Commit, .Read | .Write);
	if !ok {
		println("Failed to allocate buffer.");
		for {}
	}
	buf := p as *string;
	read := readdir(root, buf[:1024]);
	if read < 0 {
		println("Failed to read root: %", read);
		for {}
	}
	dirs := buf[:read];
	println("Dirs: %", dirs);

	println("Initiated!");
	for {
	}
}


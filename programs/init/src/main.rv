module main;

_ :: #import sys;




_start :: fn() #foreign #link="_start" {
	tty := syscall(.open, "/dev/tty0", 0);
	if tty < 0 {
		for {}
	}
	syscall(.write, tty, "Initial process started!\n");

	pid := syscall(.spawn, "/mnt/blit");
	print_num(tty, "Parent: ", syscall(.getpid));
	print_num(tty, "Spawned: ", pid);
	for {
		syscall(.write, tty, "PROCESS 1!\n");
	}
}

